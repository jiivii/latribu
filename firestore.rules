rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'jjosevilla01@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validation Blueprints
    function isValidReservation(data) {
      return data.keys().hasAll([
          'ownerId', 'firstName', 'lastName', 'date', 'startTime', 'endTime',
          'slotType', 'eventType', 'guests', 'status', 'source', 'totalPrice',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'firstName', 'lastName', 'date', 'startTime', 'endTime',
          'slotType', 'eventType', 'guests', 'status', 'source', 'notes',
          'totalPrice', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.firstName is string && data.firstName.size() >= 2 && data.firstName.size() <= 80 &&
        data.lastName is string && data.lastName.size() >= 2 && data.lastName.size() <= 100 &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.endTime is string && data.endTime.size() == 5 && data.endTime.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.slotType is string && data.slotType.size() >= 4 && data.slotType.size() <= 20 &&
        data.slotType in ['morning', 'afternoon', 'full_day', 'custom'] &&
        data.eventType is string && data.eventType.size() >= 2 && data.eventType.size() <= 80 &&
        data.guests is int && data.guests >= 1 && data.guests <= 120 &&
        data.status is string && data.status.size() >= 6 && data.status.size() <= 20 &&
        data.status in ['pending', 'confirmed', 'cancelled', 'completed'] &&
        data.source is string && data.source.size() >= 3 && data.source.size() <= 20 &&
        data.source in ['web', 'phone', 'whatsapp', 'walkin'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReservationPrivateContact(data, reservationId) {
      return data.keys().hasAll(['ownerId', 'reservationId', 'phone', 'email', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'reservationId', 'phone', 'email', 'createdAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.reservationId is string && data.reservationId == reservationId &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidCalendarBlock(data) {
      return data.keys().hasAll([
          'ownerId', 'date', 'slotType', 'startTime', 'endTime', 'reason', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'date', 'slotType', 'startTime', 'endTime', 'reason', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.slotType is string && data.slotType.size() >= 4 && data.slotType.size() <= 20 &&
        data.slotType in ['morning', 'afternoon', 'full_day', 'custom'] &&
        data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.endTime is string && data.endTime.size() == 5 && data.endTime.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'role', 'createdAt']) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.role is string && data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    // Collection: /reservations/{reservationId}
    match /reservations/{reservationId} {
      allow get: if isVerifiedUser() && isValidId(reservationId) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );

      allow list: if isVerifiedUser() && (
        existing().ownerId == request.auth.uid || isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(reservationId) &&
        isValidReservation(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().status == 'pending' || isAdmin());

      allow update: if isVerifiedUser() &&
        isValidId(reservationId) &&
        isValidReservation(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            !(existing().status in ['cancelled', 'completed']) &&
            (
              // Action 1: Customer updates notes or guest count while still pending
              (
                existing().status == 'pending' &&
                incoming().status == 'pending' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'guests', 'updatedAt'])
              ) ||
              // Action 2: Customer cancels their own pending reservation
              (
                existing().status == 'pending' &&
                incoming().status == 'cancelled' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              )
            )
          )
        );

      allow delete: if isVerifiedUser() && isValidId(reservationId) && isAdmin();

      // Subcollection: /reservations/{reservationId}/private/{infoId} (PII Isolation)
      match /private/{infoId} {
        allow get: if isVerifiedUser() &&
          isValidId(reservationId) &&
          isValidId(infoId) &&
          (
            isAdmin() ||
            (
              exists(/databases/$(database)/documents/reservations/$(reservationId)) &&
              get(/databases/$(database)/documents/reservations/$(reservationId)).data.ownerId == request.auth.uid &&
              existing().ownerId == request.auth.uid
            )
          );

        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidId(reservationId) &&
          isValidId(infoId) &&
          isValidReservationPrivateContact(incoming(), reservationId) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          (
            isAdmin() ||
            (
              existsAfter(/databases/$(database)/documents/reservations/$(reservationId)) &&
              getAfter(/databases/$(database)/documents/reservations/$(reservationId)).data.ownerId == request.auth.uid
            )
          );

        allow update: if isVerifiedUser() &&
          isValidId(reservationId) &&
          isValidId(infoId) &&
          isValidReservationPrivateContact(incoming(), reservationId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().reservationId == existing().reservationId &&
          incoming().createdAt == existing().createdAt &&
          (
            isAdmin() ||
            (
              exists(/databases/$(database)/documents/reservations/$(reservationId)) &&
              get(/databases/$(database)/documents/reservations/$(reservationId)).data.ownerId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'email'])
            )
          );

        allow delete: if isVerifiedUser() &&
          isValidId(reservationId) &&
          isValidId(infoId) &&
          isAdmin();
      }
    }

    // Collection: /calendarBlocks/{blockId}
    match /calendarBlocks/{blockId} {
      allow get: if isVerifiedUser() && isValidId(blockId);

      allow list: if isVerifiedUser() && existing().date is string;

      allow create: if isVerifiedUser() &&
        isValidId(blockId) &&
        isValidCalendarBlock(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(blockId) &&
        isValidCalendarBlock(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['date', 'slotType', 'startTime', 'endTime', 'reason', 'updatedAt']) &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(blockId) && isAdmin();
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(adminId) &&
        isValidAdminUser(incoming()) &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update, delete: if false;
    }
  }
}
